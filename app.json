{
  "expo": {
    "name": "Mock Trial Central",
    "slug": "mock-trial-central",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mocktrialcentral.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8F5EE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mocktrialcentral.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": false
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Mock Trial Central uses the camera to photograph paper ballots so they can be entered.",
          "photosPermission": "Mock Trial Central opens your photos so you can pick a photo of a paper ballot."
        }
      ],
      "expo-notifications"
    ],
    "scheme": "mocktrial",
    "owner": "mccox777",
    "extra": {
      "eas": {
        "projectId": "ab7cc11c-dfde-4530-902b-c46f111f3a9f"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ab7cc11c-dfde-4530-902b-c46f111f3a9f",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
